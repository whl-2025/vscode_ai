{
  "name": "gpt-ccdc",
  "displayName": "GPT.CCDC",
  "description": "GPT tool inside VS Code.",
  "version": "0.0.3",
  "publisher": "ccdc-lab",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ccdc.openChat",
        "title": "Ccdc: Open Chat"
      },
      {
        "command": "ccdc.generateCode",
        "title": "Ccdc: Generate Code"
      },
      {
        "command": "ccdc.openConfig",
        "title": "Ccdc: Open Configuration"
      },
      {
        "command": "ccdc.exportHistory",
        "title": "Ccdc: Export Chat History"
      },
      {
        "command": "ccdc.importHistory",
        "title": "Ccdc: Import Chat History"
      },
      {
        "command": "ccdc.clearHistory",
        "title": "Ccdc: Clear Chat History"
      },
      {
        "command": "ccdc.showStats",
        "title": "Ccdc: Show Statistics"
      },
      {
        "command": "ccdc.showMainDatabase",
        "title": "Ccdc: Show Main Database Info"
      },
      {
        "command": "ccdc.showProjectDatabase",
        "title": "Ccdc: Show Project Database Info"
      },
      {
        "command": "ccdc.showSessions",
        "title": "Ccdc: Show Chat Sessions"
      },
      {
        "command": "ccdc.showGeneratedFiles",
        "title": "Ccdc: Show Generated Files"
      },
      {
        "command": "ccdc.searchMessages",
        "title": "Ccdc: Search Messages"
      },
      {
        "command": "ccdc.testSQLite",
        "title": "Ccdc: Test SQLite"
      },
      {
        "command": "ccdc.checkStorage",
        "title": "Ccdc: Check Storage Status"
      },
      {
        "command": "ccdc.checkStorageStatus",
        "title": "Ccdc: Check Storage Status (Detailed)"
      },
      {
        "command": "ccdc.diagnostic",
        "title": "Ccdc: Diagnostic"
      },
      {
        "command": "ccdc.createStorage",
        "title": "Ccdc: Create Storage Directory"
      },
      {
        "command": "ccdc.fixIntranet",
        "title": "Ccdc: Fix Intranet Environment"
      },
      {
        "command": "ccdc.testApi",
        "title": "Ccdc: Test API Connection"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ccdc_chat",
          "title": "CCDC",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ccdc_chat": [
        {
          "type": "webview",
          "id": "ccdc.chatView",
          "name": "Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ccdc.chatView",
        "contents": "Welcome to gpt.ccdc Chat!"
      }
    ],
    "configuration": {
      "title": "AI Code Generation",
      "properties": {
        "ccdcCodeGen.apiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key used for Authorization header (Bearer). Leave empty if your server doesn't require it.",
          "markdownDescription": "Optional API key used for Authorization header (Bearer). Leave empty if your server doesn't require it."
        },
        "ccdcCodeGen.baseUrl": {
          "type": "string",
          "default": "https://gpt.ccdc.com.cn",
          "description": "The base URL for the AI service."
        },
        "ccdcCodeGen.model": {
          "type": "string",
          "default": "gpt-3.5-turbo",
          "description": "The model to use for code generation."
        },
        "ccdcCodeGen.temperature": {
          "type": "number",
          "default": 0.1,
          "minimum": 0,
          "maximum": 1,
          "description": "The sampling temperature."
        },
        "ccdcCodeGen.maxTokens": {
          "type": "integer",
          "default": 1024,
          "minimum": 1,
          "maximum": 4096,
          "description": "The maximum number of tokens to generate in the completion."
        },
        "ccdcCodeGen.timeoutMs": {
          "type": "integer",
          "default": 120000,
          "minimum": 1000,
          "description": "The timeout for the AI request in milliseconds."
        },
        "ccdcCodeGen.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "none",
            "info",
            "debug"
          ],
          "description": "The logging level for the extension."
        },
        "ccdcCodeGen.useDatabase": {
          "type": "boolean",
          "default": true,
          "description": "Use database to store chat history (otherwise use localStorage)"
        },
        "ccdcCodeGen.maxHistoryDays": {
          "type": "number",
          "default": 30,
          "description": "Number of days to keep chat history (0 for unlimited)"
        },
        "ccdcCodeGen.autoSaveGenerated": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save generated code to generated/ folder"
        },
        "ccdcCodeGen.storageStrategy": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "default": "workspace",
          "description": "Storage strategy: 'workspace' for per-project storage, 'global' for cross-project storage"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "dependencies": {
    "sqlite3": "^5.1.6"
  },
  "bundleDependencies": [
    "sqlite3"
  ],
  "devDependencies": {
    "@types/sqlite3": "^3.1.8",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
